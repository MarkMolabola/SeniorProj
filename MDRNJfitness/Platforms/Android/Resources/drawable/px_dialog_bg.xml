<?xml version="1.0" encoding="utf-8"?>
<!-- Pixel panel for native dialogs: square corners, ink border, hard drop shadow. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
       android:insetLeft="20dp"
       android:insetRight="20dp"
       android:insetTop="16dp"
       android:insetBottom="16dp">
    <layer-list>
        <item android:top="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#73000000" />
            </shape>
        </item>
        <item android:bottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/pxPanel" />
                <stroke android:width="3dp" android:color="@color/colorAccent" />
            </shape>
        </item>
    </layer-list>
</inset>
