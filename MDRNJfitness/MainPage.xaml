<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    x:Class="SelectWorkoutRoutine.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:SelectWorkoutRoutine.ViewModels"
    Title="Select Workout">

    <ContentPage.BindingContext>
        <viewmodels:WorkoutViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label 
            Text="Select Your Workout Routine"
            FontSize="22"
            HorizontalOptions="Center" />

        <Picker
            Title="Choose Workout"
            ItemsSource="{Binding Workouts}"
            SelectedItem="{Binding SelectedWorkout}" />

        <Button
            Text="Confirm Selection"
            Command="{Binding ConfirmWorkoutCommand}" />

    </VerticalStackLayout>

</ContentPage>
