<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MDRNJfitness.Views.LoginPage"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

            <Label Text="MDRNJ Fitness"
                   FontSize="32" FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource Primary}" />

            <Label Text="{Binding Title}"
                   FontSize="20"
                   HorizontalOptions="Center" />

            <Border StrokeShape="RoundRectangle 12" Padding="16" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="12">

                    <Entry Placeholder="Email"
                           Text="{Binding Email}"
                           Keyboard="Email" />

                    <Entry Placeholder="Password"
                           Text="{Binding Password}"
                           IsPassword="True" />

                    <Entry Placeholder="Username"
                           Text="{Binding Username}"
                           IsVisible="{Binding IsRegisterMode}" />

                    <Entry Placeholder="Display Name"
                           Text="{Binding DisplayName}"
                           IsVisible="{Binding IsRegisterMode}" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Sign In"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    IsVisible="{Binding IsRegisterMode, Converter={StaticResource InvertBool}}" />

            <Button Text="Register"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    IsVisible="{Binding IsRegisterMode}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <Button Text="Need an account? Register"
                    Command="{Binding ToggleModeCommand}"
                    IsVisible="{Binding IsRegisterMode, Converter={StaticResource InvertBool}}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />

            <Button Text="Already have an account? Sign In"
                    Command="{Binding ToggleModeCommand}"
                    IsVisible="{Binding IsRegisterMode}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
