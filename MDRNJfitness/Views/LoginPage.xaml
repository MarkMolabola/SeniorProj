<?xml version="1.0" encoding="utf-8" ?>
<!-- Title screen: sign in, register, email verification, and forgot password. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:MDRNJfitness.Views"
             x:Class="MDRNJfitness.Views.LoginPage"
             Style="{StaticResource PxPage}">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24,40" Spacing="20" VerticalOptions="Center">

            <!-- ── Title ─────────────────────────────────────────────── -->
            <Border Style="{StaticResource PxSunken}" HorizontalOptions="Center" Padding="10">
                <local:PixelAvatarView x:Name="Mascot" WidthRequest="112" HeightRequest="112" />
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label Style="{StaticResource PxTitle}"
                       Text="MDRNJ"
                       FontSize="30"
                       TextColor="{StaticResource PxGold}"
                       HorizontalOptions="Center" />
                <Label Style="{StaticResource PxTitle}"
                       Text="FITNESS"
                       FontSize="16"
                       HorizontalOptions="Center" />
                <Label Style="{StaticResource PxMuted}"
                       Text="Train hard. Level up."
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- ── Sign in / Register ───────────────────────────────── -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsMainMode}">

                <Border Style="{StaticResource PxPanel}">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource PxHeading}"
                               Text="{Binding Title}"
                               TextTransform="Uppercase" />

                        <Label Style="{StaticResource PxCaption}" Text="EMAIL" />
                        <Border Style="{StaticResource PxSunken}" Padding="10,0">
                            <Entry Style="{StaticResource PxEntry}"
                                   Placeholder="you@example.com"
                                   Text="{Binding Email}"
                                   Keyboard="Email" />
                        </Border>

                        <Label Style="{StaticResource PxCaption}" Text="PASSWORD" />
                        <Border Style="{StaticResource PxSunken}" Padding="10,0">
                            <Entry Style="{StaticResource PxEntry}"
                                   Placeholder="••••••••"
                                   Text="{Binding Password}"
                                   IsPassword="True" />
                        </Border>

                        <VerticalStackLayout Spacing="10" IsVisible="{Binding IsRegisterMode}">
                            <Label Style="{StaticResource PxCaption}" Text="USERNAME" />
                            <Border Style="{StaticResource PxSunken}" Padding="10,0">
                                <Entry Style="{StaticResource PxEntry}"
                                       Placeholder="hero_name"
                                       Text="{Binding Username}" />
                            </Border>

                            <Label Style="{StaticResource PxCaption}" Text="DISPLAY NAME" />
                            <Border Style="{StaticResource PxSunken}" Padding="10,0">
                                <Entry Style="{StaticResource PxEntry}"
                                       Placeholder="What friends see"
                                       Text="{Binding DisplayName}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Style="{StaticResource PxButton}"
                        Text="START"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        IsVisible="{Binding IsRegisterMode, Converter={StaticResource InvertBool}}" />

                <Button Style="{StaticResource PxLinkButton}"
                        Text="Forgot password?"
                        TextColor="{StaticResource PxTextMuted}"
                        Command="{Binding ForgotPasswordCommand}"
                        IsVisible="{Binding IsRegisterMode, Converter={StaticResource InvertBool}}"
                        HorizontalOptions="Center" />

                <Button Style="{StaticResource PxButton}"
                        Text="CREATE HERO"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        IsVisible="{Binding IsRegisterMode}" />

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsGoogleSignInSupported}">
                    <Label Style="{StaticResource PxMuted}" Text="— or —" HorizontalOptions="Center" />
                    <Button Style="{StaticResource PxButtonSecondary}"
                            Text="CONTINUE WITH GOOGLE"
                            Command="{Binding SignInWithGoogleCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>

                <Button Style="{StaticResource PxLinkButton}"
                        Text="New here? Create an account"
                        Command="{Binding ToggleModeCommand}"
                        IsVisible="{Binding IsRegisterMode, Converter={StaticResource InvertBool}}"
                        HorizontalOptions="Center" />

                <Button Style="{StaticResource PxLinkButton}"
                        Text="Already have an account? Sign in"
                        Command="{Binding ToggleModeCommand}"
                        IsVisible="{Binding IsRegisterMode}"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- ── Verify email ─────────────────────────────────────── -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsVerifyMode}">

                <Border Style="{StaticResource PxPanel}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource PxHeading}" Text="CHECK YOUR EMAIL" />
                        <Label Style="{StaticResource PxMuted}" Text="{Binding VerifyMessage}" />
                        <Label Style="{StaticResource PxBody}"
                               Text="{Binding Email}"
                               TextColor="{StaticResource PxTeal}" />

                        <Border Style="{StaticResource PxSunken}" Padding="10,4">
                            <Entry Style="{StaticResource PxEntry}"
                                   Placeholder="000000"
                                   Text="{Binding VerificationCode}"
                                   Keyboard="Numeric"
                                   MaxLength="6"
                                   FontSize="34"
                                   CharacterSpacing="10"
                                   TextColor="{StaticResource PxGold}"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Button Style="{StaticResource PxButton}"
                        Text="VERIFY"
                        Command="{Binding VerifyEmailCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0"
                            Style="{StaticResource PxLinkButton}"
                            Text="Resend code"
                            Command="{Binding ResendCodeCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource PxLinkButton}"
                            Text="Back to sign in"
                            TextColor="{StaticResource PxTextMuted}"
                            Command="{Binding BackToSignInCommand}" />
                </Grid>
            </VerticalStackLayout>

            <!-- ── Forgot password ──────────────────────────────────── -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsResetMode}">

                <!-- Step 1: where to send the code -->
                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding IsResetCodeSent, Converter={StaticResource InvertBool}}">
                    <Border Style="{StaticResource PxPanel}">
                        <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource PxHeading}" Text="FORGOT PASSWORD" />
                            <Label Style="{StaticResource PxMuted}"
                                   Text="Enter your account email and we'll send you a 6-digit code to choose a new password." />
                            <Label Style="{StaticResource PxCaption}" Text="EMAIL" />
                            <Border Style="{StaticResource PxSunken}" Padding="10,0">
                                <Entry Style="{StaticResource PxEntry}"
                                       Placeholder="you@example.com"
                                       Text="{Binding Email}"
                                       Keyboard="Email" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Button Style="{StaticResource PxButton}"
                            Text="SEND CODE"
                            Command="{Binding SendResetCodeCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>

                <!-- Step 2: code + new password -->
                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsResetCodeSent}">
                    <Border Style="{StaticResource PxPanel}">
                        <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource PxHeading}" Text="CHECK YOUR EMAIL" />
                            <Label Style="{StaticResource PxMuted}"
                                   Text="If an account uses this email, we sent it a code. It expires in 15 minutes." />
                            <Label Style="{StaticResource PxBody}"
                                   Text="{Binding Email}"
                                   TextColor="{StaticResource PxTeal}" />

                            <Border Style="{StaticResource PxSunken}" Padding="10,4">
                                <Entry Style="{StaticResource PxEntry}"
                                       Placeholder="000000"
                                       Text="{Binding ResetCode}"
                                       Keyboard="Numeric"
                                       MaxLength="6"
                                       FontSize="34"
                                       CharacterSpacing="10"
                                       TextColor="{StaticResource PxGold}"
                                       HorizontalTextAlignment="Center" />
                            </Border>

                            <Label Style="{StaticResource PxCaption}" Text="NEW PASSWORD" />
                            <Border Style="{StaticResource PxSunken}" Padding="10,0">
                                <Entry Style="{StaticResource PxEntry}"
                                       Placeholder="At least 8 characters"
                                       Text="{Binding NewPassword}"
                                       IsPassword="True" />
                            </Border>

                            <Label Style="{StaticResource PxCaption}" Text="CONFIRM PASSWORD" />
                            <Border Style="{StaticResource PxSunken}" Padding="10,0">
                                <Entry Style="{StaticResource PxEntry}"
                                       Placeholder="••••••••"
                                       Text="{Binding ConfirmPassword}"
                                       IsPassword="True" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Button Style="{StaticResource PxButton}"
                            Text="RESET PASSWORD"
                            Command="{Binding ResetPasswordCommand}"
                            IsEnabled="{Binding IsNotBusy}" />

                    <Button Style="{StaticResource PxLinkButton}"
                            Text="Resend code"
                            Command="{Binding SendResetCodeCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Button Style="{StaticResource PxLinkButton}"
                        Text="Back to sign in"
                        TextColor="{StaticResource PxTextMuted}"
                        Command="{Binding BackToSignInCommand}"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PxGold}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
