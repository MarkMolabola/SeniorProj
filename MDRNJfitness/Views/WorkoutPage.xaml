<?xml version="1.0" encoding="utf-8" ?>
<!-- Start / finish a live workout, plus recent history. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:conv="clr-namespace:MDRNJfitness.Helpers.Converters"
             x:Class="MDRNJfitness.Views.WorkoutPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertBool" />
        <conv:UtcToLocalConverter x:Key="UtcToLocal" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="24">

            <Label Style="{StaticResource PxTitle}" Text="TRAINING" />

            <!-- ── Start a workout ─────────────────────────────────── -->
            <Border Style="{StaticResource PxPanel}"
                    IsVisible="{Binding HasActiveWorkout, Converter={StaticResource InvertBool}}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PxHeading}" Text="NEW SESSION" />
                    <Label Style="{StaticResource PxMuted}" Text="Pick your training, then hit START. XP and stat points are awarded when you finish." />

                    <Label Style="{StaticResource PxCaption}" Text="TRAINING TYPE" />
                    <Border Style="{StaticResource PxSunken}" Padding="10,0">
                        <Picker Style="{StaticResource PxPicker}"
                                Title="Workout type"
                                ItemsSource="{Binding WorkoutTypes}"
                                SelectedItem="{Binding WorkoutType}" />
                    </Border>

                    <Button Style="{StaticResource PxButton}"
                            Text="▶ START"
                            Command="{Binding StartWorkoutCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Active workout ──────────────────────────────────── -->
            <Border Style="{StaticResource PxPanelHighlight}" IsVisible="{Binding HasActiveWorkout}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource PxHeading}"
                               Text="{Binding ActiveWorkout.WorkoutType}"
                               TextTransform="Uppercase" />
                        <Border Grid.Column="1" Style="{StaticResource PxChip}">
                            <Label Style="{StaticResource PxCaption}" Text="IN PROGRESS" TextColor="{StaticResource PxGoldInk}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource PxSunken}" Padding="16,22">
                        <Label Style="{StaticResource PxTitle}"
                               Text="{Binding ElapsedTime}"
                               FontSize="34"
                               TextColor="{StaticResource PxTeal}"
                               HorizontalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding TracksDistance}">
                        <Label Style="{StaticResource PxCaption}" Text="DISTANCE (KM) · OPTIONAL" />
                        <Border Style="{StaticResource PxSunken}" Padding="10,0">
                            <Entry Style="{StaticResource PxEntry}"
                                   Text="{Binding DistanceKm}"
                                   Keyboard="Numeric"
                                   Placeholder="e.g. 5.0" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Style="{StaticResource PxButton}"
                            Text="■ FINISH"
                            Command="{Binding CompleteWorkoutCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── History ─────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="14">
                <Label Style="{StaticResource PxCaption}" Text="RECENT SESSIONS" />

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding History}">
                    <BindableLayout.EmptyView>
                        <Border Style="{StaticResource PxPanel}">
                            <Label Style="{StaticResource PxMuted}" Text="No sessions yet. Start one above!" />
                        </Border>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PxPanel}" Padding="16,12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Style="{StaticResource PxBody}"
                                               Text="{Binding WorkoutType}"
                                               TextColor="{StaticResource PxTeal}" />
                                        <Label Style="{StaticResource PxMuted}"
                                               Text="{Binding StartTime, Converter={StaticResource UtcToLocal}, StringFormat='{0:MMM d · h:mm tt}'}" />
                                        <Label Style="{StaticResource PxMuted}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DurationMins, StringFormat='{0} min'}" />
                                                    <Span Text="{Binding DistanceKm, StringFormat=' · {0:0.##} km', TargetNullValue=''}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Style="{StaticResource PxXp}"
                                           Text="{Binding XPAwarded, StringFormat='+{0} XP'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
