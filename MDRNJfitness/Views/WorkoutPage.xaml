<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:conv="clr-namespace:MDRNJfitness.Helpers.Converters"
             x:Class="MDRNJfitness.Views.WorkoutPage"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertBool" />
        <conv:UtcToLocalConverter x:Key="UtcToLocal" />
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Start / active workout card -->
                <Border StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Start a Workout" FontAttributes="Bold" FontSize="18" />

                        <Picker Title="Workout Type"
                                SelectedItem="{Binding WorkoutType}"
                                IsEnabled="{Binding HasActiveWorkout, Converter={StaticResource InvertBool}}">
                            <Picker.Items>
                                <x:String>Running</x:String>
                                <x:String>Weightlifting</x:String>
                                <x:String>Cycling</x:String>
                                <x:String>Swimming</x:String>
                                <x:String>HIIT</x:String>
                                <x:String>Yoga</x:String>
                                <x:String>Boxing</x:String>
                                <x:String>Hiking</x:String>
                                <x:String>Rowing</x:String>
                                <x:String>Basketball</x:String>
                                <x:String>Other</x:String>
                            </Picker.Items>
                        </Picker>

                        <Button Text="Start Workout"
                                Command="{Binding StartWorkoutCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                IsVisible="{Binding HasActiveWorkout, Converter={StaticResource InvertBool}}" />

                        <!-- Active workout info + stopwatch -->
                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding HasActiveWorkout}">

                            <Label Text="{Binding ActiveWorkout.WorkoutType, StringFormat='Active: {0}'}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

                            <!-- Stopwatch -->
                            <Border StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource Primary}"
                                    Padding="12,8"
                                    HorizontalOptions="Center">
                                <Label Text="{Binding ElapsedTime}"
                                       FontSize="36"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       FontFamily="OpenSansRegular"
                                       HorizontalOptions="Center" />
                            </Border>

                            <Button Text="Complete Workout"
                                    Command="{Binding CompleteWorkoutCommand}"
                                    IsEnabled="{Binding IsNotBusy}"
                                    BackgroundColor="#22C55E" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- History -->
                <Label Text="Workout History" FontAttributes="Bold" FontSize="16" />

                <CollectionView ItemsSource="{Binding History}"
                                EmptyView="No workouts yet. Start one above!">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding WorkoutType}"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding StartTime,
                                                              Converter={StaticResource UtcToLocal},
                                                              StringFormat='{0:MMM d, yyyy  h:mm tt}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding DurationMins, StringFormat='{0} mins'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray400}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding XPAwarded, StringFormat='+{0} XP'}"
                                           TextColor="{StaticResource Primary}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
