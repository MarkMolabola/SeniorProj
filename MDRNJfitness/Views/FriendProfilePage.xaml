<?xml version="1.0" encoding="utf-8" ?>
<!-- A friend's hero, stats and recent training. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MDRNJfitness.Views"
             x:Class="MDRNJfitness.Views.FriendProfilePage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="20">

            <Button Style="{StaticResource PxButtonSecondary}"
                    Text="◀ BACK"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />

            <!-- ── Hero card ───────────────────────────────────────── -->
            <Border Style="{StaticResource PxPanel}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border Style="{StaticResource PxSunken}" HorizontalOptions="Center" Padding="8">
                        <local:PixelAvatarView AvatarType="{Binding Profile.SpriteState}"
                                               AvatarId="{Binding Profile.AvatarId}"
                                               Gear="{Binding Profile, Converter={StaticResource GearList}}"
                                               WidthRequest="128" HeightRequest="128" />
                    </Border>
                    <Label Style="{StaticResource PxHeading}"
                           Text="{Binding Profile.Username}"
                           TextTransform="Uppercase"
                           HorizontalOptions="Center" />
                    <Label Style="{StaticResource PxMuted}"
                           Text="{Binding Profile.DominantSport, StringFormat='Main training: {0}'}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Stats ───────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource PxSunken}" Padding="4,10">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Style="{StaticResource PxStatValue}" FontSize="28" Text="{Binding Profile.CurrentLevel}"
                               TextColor="{StaticResource PxGold}" HorizontalOptions="Center" />
                        <Label Style="{StaticResource PxCaption}" Text="LV" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PxSunken}" Padding="4,10">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Style="{StaticResource PxStatValue}" FontSize="28" Text="{Binding Profile.TotalXP}"
                               TextColor="{StaticResource PxTeal}" HorizontalOptions="Center" />
                        <Label Style="{StaticResource PxCaption}" Text="XP" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PxSunken}" Padding="4,10">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Style="{StaticResource PxStatValue}" FontSize="28" Text="{Binding Profile.TotalWorkouts}"
                               HorizontalOptions="Center" />
                        <Label Style="{StaticResource PxCaption}" Text="SESSIONS" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource PxSunken}" Padding="4,10">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Style="{StaticResource PxStatValue}" FontSize="28" Text="{Binding Profile.CurrentStreak}"
                               TextColor="{StaticResource PxOrange}" HorizontalOptions="Center" />
                        <Label Style="{StaticResource PxCaption}" Text="STREAK" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ── Recent training ─────────────────────────────────── -->
            <VerticalStackLayout Spacing="12">
                <Label Style="{StaticResource PxCaption}" Text="RECENT SESSIONS" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding RecentWorkouts}">
                    <BindableLayout.EmptyView>
                        <Border Style="{StaticResource PxPanel}">
                            <Label Style="{StaticResource PxMuted}" Text="No sessions recorded yet." />
                        </Border>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PxPanel}" Padding="16,12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Style="{StaticResource PxBody}"
                                               Text="{Binding WorkoutType}"
                                               TextColor="{StaticResource PxTeal}" />
                                        <Label Style="{StaticResource PxMuted}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding StartTime, StringFormat='{0:MMM d}'}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding DurationMins, StringFormat='{0} min'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Style="{StaticResource PxXp}"
                                           Text="{Binding XPAwarded, StringFormat='+{0} XP'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button Style="{StaticResource PxButtonDanger}"
                    Text="REMOVE FRIEND"
                    Command="{Binding RemoveFriendCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
