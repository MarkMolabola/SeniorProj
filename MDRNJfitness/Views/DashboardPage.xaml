<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MDRNJfitness.Views.DashboardPage"
    Title="Dashboard"
    BackgroundColor="#F4FFF7">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="Dashboard"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#1F2937" />

            <Frame
                BackgroundColor="White"
                BorderColor="#D9EAD3"
                CornerRadius="18"
                Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="{Binding UserName, StringFormat='Welcome back, {0}!'}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#1F2937" />

                    <Label
                        Text="{Binding CurrentLevel, StringFormat='Level {0}'}"
                        FontSize="18"
                        TextColor="#2563EB" />

                    <Label
                        Text="{Binding CurrentXP, StringFormat='XP: {0}'}"
                        FontSize="16"
                        TextColor="#4B5563" />

                    <Label
                        Text="{Binding XPToNextLevel, StringFormat='XP to next level: {0}'}"
                        FontSize="16"
                        TextColor="#4B5563" />

                    <ProgressBar
                        Progress="{Binding XPProgress}"
                        HeightRequest="10"
                        BackgroundColor="#E5E7EB" />
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <Frame Grid.Row="0" Grid.Column="0"
                       BackgroundColor="White"
                       BorderColor="#D9EAD3"
                       CornerRadius="16"
                       Padding="14">
                    <VerticalStackLayout>
                        <Label Text="Streak" FontAttributes="Bold" TextColor="#1F2937" />
                        <Label Text="{Binding Streak}" FontSize="24" TextColor="#16A34A" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1"
                       BackgroundColor="White"
                       BorderColor="#D9EAD3"
                       CornerRadius="16"
                       Padding="14">
                    <VerticalStackLayout>
                        <Label Text="Today's XP" FontAttributes="Bold" TextColor="#1F2937" />
                        <Label Text="{Binding TodayXP}" FontSize="24" TextColor="#F97316" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.ColumnSpan="2"
                       BackgroundColor="White"
                       BorderColor="#D9EAD3"
                       CornerRadius="16"
                       Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Recent Workouts"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#1F2937" />

                        <CollectionView ItemsSource="{Binding RecentWorkouts}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                        BackgroundColor="#F9FAFB"
                                        BorderColor="#E5E7EB"
                                        CornerRadius="12"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                        <VerticalStackLayout Spacing="4">
                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                TextColor="#2563EB" />
                                            <Label
                                                Text="{Binding DateDisplay}"
                                                FontSize="14"
                                                TextColor="#6B7280" />
                                            <Label
                                                Text="{Binding DurationDisplay}"
                                                FontSize="14"
                                                TextColor="#6B7280" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Button
                Text="Start Workout"
                Command="{Binding StartWorkoutCmd}"
                BackgroundColor="#FF7043"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50" />

            <Button
                Text="View Character"
                Command="{Binding ViewCharacterCmd}"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>