<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:MDRNJfitness.Helpers.Converters"
             xmlns:controls="clr-namespace:MDRNJfitness.Controls"
             xmlns:local="clr-namespace:MDRNJfitness.Views"
             x:Class="MDRNJfitness.Views.DashboardPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ContentPage.Resources>
        <conv:UtcToLocalConverter x:Key="UtcToLocal" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="24">

            <!-- Top bar -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Style="{StaticResource PxTitle}" VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="MDRNJ" TextColor="{StaticResource PxGold}" />
                            <Span Text="FIT" TextColor="{StaticResource PxTeal}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                <Border Style="{StaticResource PxChip}" Padding="10,2">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenGoldHistoryCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Image Source="icon_gold.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Style="{StaticResource PxBody}"
                               Text="{Binding GoldText}"
                               TextColor="{StaticResource PxGoldInk}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Style="{StaticResource PxChip}" Padding="10,2">
                    <HorizontalStackLayout Spacing="6">
                        <Image Source="icon_flame.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <Label Style="{StaticResource PxBody}"
                               Text="{Binding Stats.CurrentStreak}"
                               TextColor="{StaticResource PxGoldInk}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- Dungeon: the hero slays monsters for gold while you're away -->
            <Border Style="{StaticResource PxPanel}" Padding="0">
                <VerticalStackLayout>
                    <local:DungeonView HeightRequest="190"
                                       AvatarType="{Binding HeroOutfit}"
                                       AvatarId="{Binding HeroAvatarId}"
                                       Gear="{Binding Hero, Converter={StaticResource GearList}}"
                                       MonsterId="{Binding MonsterId}" />

                    <VerticalStackLayout Padding="16,14,16,16" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Style="{StaticResource PxHeading}" FontSize="10"
                                   TextColor="{StaticResource PxGold}" Text="{Binding DungeonTitle}"
                                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="1" Style="{StaticResource PxBody}"
                                   TextColor="{StaticResource PxTeal}" Text="{Binding PowerText}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Image Grid.Column="0" Source="icon_gold.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <controls:XPBarControl Grid.Column="1" Progress="{Binding PendingProgress}" HeightRequest="16" VerticalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource PxBody}" TextColor="{StaticResource PxGold}"
                                   Text="{Binding PendingText}" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Style="{StaticResource PxMuted}" Text="{Binding RateText}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDungeonFull}" Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource PxOrange}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Button Grid.Column="1"
                                    Style="{StaticResource PxButton}"
                                    Text="COLLECT"
                                    Command="{Binding CollectCommand}"
                                    IsEnabled="{Binding CanCollect}" />
                        </Grid>

                        <Label Style="{StaticResource PxBody}" TextColor="{StaticResource PxGold}"
                               Text="{Binding CollectMessage}" HorizontalOptions="Center"
                               IsVisible="{Binding HasCollectMessage}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Primary action -->
            <Button Style="{StaticResource PxButton}"
                    Text="▶ START WORKOUT"
                    Clicked="OnStartWorkoutClicked" />

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border Grid.Column="0" Style="{StaticResource PxPanel}" Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource PxCaption}" Text="STREAK" />
                        <Label Style="{StaticResource PxStatValue}" TextColor="{StaticResource PxOrange}"
                               Text="{Binding Stats.CurrentStreak}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PxPanel}" Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource PxCaption}" Text="WORKOUTS" />
                        <Label Style="{StaticResource PxStatValue}" TextColor="{StaticResource PxTeal}"
                               Text="{Binding Stats.TotalWorkouts}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PxPanel}" Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource PxCaption}" Text="BEST" />
                        <Label Style="{StaticResource PxStatValue}" TextColor="{StaticResource PxGold}"
                               Text="{Binding Stats.LongestStreak}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Achievements -->
            <Border Style="{StaticResource PxPanel}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PxHeading}" Text="ACHIEVEMENTS" />

                    <Label Style="{StaticResource PxMuted}"
                           Text="No achievements unlocked yet. Keep training!"
                           IsVisible="{Binding HasNoAchievements}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Achievements}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Style="{StaticResource PxSlot}" WidthRequest="48" HeightRequest="48">
                                        <Label Text="★" FontSize="24" TextColor="{StaticResource PxGold}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Style="{StaticResource PxBody}" Text="{Binding Name}" />
                                        <Label Style="{StaticResource PxMuted}" FontSize="17" Text="{Binding Description}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Style="{StaticResource PxXp}"
                                           Text="{Binding XPReward, StringFormat='+{0} XP'}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Recent workouts -->
            <Border Style="{StaticResource PxPanel}">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource PxHeading}" Text="BATTLE LOG" Margin="0,0,0,8" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentWorkouts}">
                        <BindableLayout.EmptyView>
                            <Label Style="{StaticResource PxMuted}" Text="No battles yet. Start a workout!" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Style="{StaticResource PxBody}" TextColor="{StaticResource PxTeal}"
                                                   Text="{Binding WorkoutType}" />
                                            <Label Style="{StaticResource PxMuted}" FontSize="18">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding StartTime, Converter={StaticResource UtcToLocal}, StringFormat='{0:MMM d}'}" />
                                                        <Span Text=" · " />
                                                        <Span Text="{Binding DurationMins, StringFormat='{0} min'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Style="{StaticResource PxXp}"
                                               Text="{Binding XPAwarded, StringFormat='+{0} XP'}" />
                                    </Grid>
                                    <BoxView HeightRequest="2" Color="{StaticResource PxTrack}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
