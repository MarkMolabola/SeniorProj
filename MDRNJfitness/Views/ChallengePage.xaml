<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.ChallengePage"
             Title="{Binding Title}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Active Challenges -->
                <Label Text="Available Challenges" FontAttributes="Bold" FontSize="16" />

                <CollectionView ItemsSource="{Binding ActiveChallenges}"
                                EmptyView="No active challenges.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontAttributes="Bold" />
                                        <Label Grid.Column="1"
                                               Text="{Binding XPReward, StringFormat='{0} XP'}"
                                               TextColor="{StaticResource Primary}"
                                               FontAttributes="Bold" />
                                    </Grid>
                                    <Label Text="{Binding Description}" FontSize="12" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding EndDate, StringFormat='Ends: {0:MMM d}'}"
                                               FontSize="11" TextColor="{StaticResource Gray400}" />
                                        <Button Grid.Column="1"
                                                Text="Join"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.JoinCommand}"
                                                CommandParameter="{Binding .}"
                                                Padding="12,4"
                                                HeightRequest="32" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- My Challenges -->
                <Label Text="My Challenges" FontAttributes="Bold" FontSize="16" />

                <CollectionView ItemsSource="{Binding MyChallenges}"
                                EmptyView="You haven't joined any challenges.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontAttributes="Bold" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Status}"
                                               FontSize="12"
                                               TextColor="{StaticResource Primary}" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding Progress}" />
                                    <Label Text="{Binding Progress, StringFormat='{0:P0} complete'}"
                                           FontSize="11" TextColor="{StaticResource Gray400}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
