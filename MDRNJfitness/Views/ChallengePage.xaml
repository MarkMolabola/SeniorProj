<?xml version="1.0" encoding="utf-8" ?>
<!-- 1v1 friend challenges: incoming, active, sent, and finished. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MDRNJfitness.ViewModels"
             x:Class="MDRNJfitness.Views.ChallengePage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ContentPage.Resources>
        <DataTemplate x:Key="ChallengeCardTemplate">
            <Border Style="{StaticResource PxPanel}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsFinished}" Value="True">
                        <Setter Property="Opacity" Value="0.7" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsWon}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource PxGold}" />
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Border.Triggers>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource PxHeading}" Text="{Binding Title}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource PxXp}"
                               FontSize="18"
                               VerticalOptions="Start"
                               Text="{Binding StatusText}" />
                    </Grid>

                    <Label Style="{StaticResource PxBody}" Text="{Binding VersusText}" />
                    <Label Style="{StaticResource PxMuted}" Text="{Binding ModeText}" />
                    <Label Style="{StaticResource PxCaption}" TextColor="{StaticResource PxOrange}"
                           Text="{Binding ProofRuleText}" IsVisible="{Binding Dto.RequireProof}" />

                    <Border Style="{StaticResource PxSunken}" Padding="14,10" IsVisible="{Binding ShowScores}">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                            <Label Grid.Column="0" Style="{StaticResource PxCaption}" Text="YOU" />
                            <Label Grid.Column="1" Style="{StaticResource PxCaption}" Text="{Binding Dto.OpponentUsername}" TextTransform="Uppercase" />
                            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource PxStatValue}" FontSize="28"
                                   TextColor="{StaticResource PxTeal}" Text="{Binding MyScoreText}" />
                            <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource PxStatValue}" FontSize="28"
                                   TextColor="{StaticResource PxStr}" Text="{Binding TheirScoreText}" />
                        </Grid>
                    </Border>

                    <!-- Proof attached so far -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasProofs}"
                                         BindableLayout.ItemsSource="{Binding Proofs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Style="{StaticResource PxBody}" Text="{Binding Label}" VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource PxButtonSecondary}"
                                            Text="VIEW"
                                            Padding="12,4"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChallengeViewModel}}, Path=ViewProofCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Review window -->
                    <Label Style="{StaticResource PxMuted}" Text="{Binding ReviewText}" IsVisible="{Binding IsInReview}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding Dto.CanReview}">
                        <Button Grid.Column="0"
                                Style="{StaticResource PxButtonDanger}"
                                Text="DISPUTE"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChallengeViewModel}}, Path=DisputeCommand}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource PxButton}"
                                Text="APPROVE"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChallengeViewModel}}, Path=ApproveCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                    <Label Style="{StaticResource PxMuted}" TextColor="{StaticResource PxStr}"
                           Text="{Binding DisputeText}" IsVisible="{Binding IsDisputed}" />

                    <!-- Opponent answering an invite -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding Dto.CanRespond}">
                        <Button Grid.Column="0"
                                Style="{StaticResource PxButtonSecondary}"
                                Text="DECLINE"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChallengeViewModel}}, Path=DeclineCommand}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource PxButton}"
                                Text="ACCEPT"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChallengeViewModel}}, Path=AcceptCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>

                    <Button Style="{StaticResource PxButtonSecondary}"
                            Text="WITHDRAW"
                            IsVisible="{Binding Dto.CanCancel}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChallengeViewModel}}, Path=CancelCommand}"
                            CommandParameter="{Binding .}" />

                    <Button Style="{StaticResource PxButton}"
                            Text="{Binding SubmitText}"
                            IsVisible="{Binding Dto.CanSubmit}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChallengeViewModel}}, Path=SubmitCommand}"
                            CommandParameter="{Binding .}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="20">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Style="{StaticResource PxTitle}"
                       Text="CHALLENGES"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource PxButtonSecondary}"
                        Text="+ NEW"
                        Command="{Binding OpenFormCommand}" />
            </Grid>

            <Border Style="{StaticResource PxPanelHighlight}" IsVisible="{Binding IsUploading}">
                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource PxTeal}" WidthRequest="24" HeightRequest="24" />
                    <Label Style="{StaticResource PxBody}" Text="{Binding UploadStatus}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- ── New challenge form ─────────────────────────────────── -->
            <Border Style="{StaticResource PxPanelHighlight}" IsVisible="{Binding IsFormOpen}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PxHeading}" Text="ISSUE A CHALLENGE" />

                    <Label Style="{StaticResource PxCaption}" Text="OPPONENT" />
                    <Border Style="{StaticResource PxSunken}" Padding="10,0">
                        <Picker Style="{StaticResource PxPicker}"
                                Title="Pick a friend"
                                ItemsSource="{Binding Friends}"
                                ItemDisplayBinding="{Binding Username}"
                                SelectedItem="{Binding FormFriend}" />
                    </Border>

                    <Label Style="{StaticResource PxCaption}" Text="CONTEST" />
                    <Border Style="{StaticResource PxSunken}" Padding="10,0">
                        <Picker Style="{StaticResource PxPicker}"
                                ItemsSource="{Binding Contests}"
                                SelectedIndex="{Binding FormContestIndex}" />
                    </Border>

                    <Label Style="{StaticResource PxCaption}" Text="SCORING" />
                    <Border Style="{StaticResource PxSunken}" Padding="10,0">
                        <Picker Style="{StaticResource PxPicker}"
                                ItemsSource="{Binding ScoringModes}"
                                SelectedIndex="{Binding FormScoringIndex}" />
                    </Border>

                    <VerticalStackLayout Spacing="12" IsVisible="{Binding FormNeedsDistance}">
                        <Label Style="{StaticResource PxCaption}" Text="RACE DISTANCE (KM)" />
                        <Border Style="{StaticResource PxSunken}" Padding="10,0">
                            <Entry Style="{StaticResource PxEntry}"
                                   Keyboard="Numeric"
                                   Placeholder="1.6"
                                   Text="{Binding FormDistanceKm}" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Style="{StaticResource PxCaption}" Text="DEADLINE" />
                    <Border Style="{StaticResource PxSunken}" Padding="10,0">
                        <Picker Style="{StaticResource PxPicker}"
                                ItemsSource="{Binding Durations}"
                                SelectedIndex="{Binding FormDurationIndex}" />
                    </Border>

                    <Label Style="{StaticResource PxMuted}" Text="{Binding FormRulesText}" />

                    <Border Style="{StaticResource PxSunken}" Padding="12,8">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Style="{StaticResource PxCaption}" Text="REQUIRE PROOF" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding FormRequireProof}"
                                        OnColor="{StaticResource PxTeal}" ThumbColor="{StaticResource PxText}" />
                            </Grid>
                            <Label Style="{StaticResource PxMuted}" Text="{Binding FormProofHint}" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding FormRequireProof}">
                                <Label Style="{StaticResource PxCaption}" Text="OPPONENT CAN REVIEW + DISPUTE" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding FormAllowDisputes}"
                                        OnColor="{StaticResource PxTeal}" ThumbColor="{StaticResource PxText}" />
                            </Grid>
                            <Label Style="{StaticResource PxMuted}" IsVisible="{Binding FormRequireProof}"
                                   Text="On: results wait for a 24h review, and a dispute voids the duel. Off: results count right away." />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Style="{StaticResource PxButtonSecondary}"
                                Text="CANCEL"
                                Command="{Binding CloseFormCommand}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource PxButton}"
                                Text="SEND"
                                Command="{Binding SendChallengeCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource PxPanel}" IsVisible="{Binding HasNothing}">
                <Label Style="{StaticResource PxMuted}"
                       Text="No challenges yet. Tap + NEW to challenge a friend to push-ups, pull-ups, a plank or a run!" />
            </Border>

            <!-- ── Sections ───────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding HasIncoming}">
                <Label Style="{StaticResource PxCaption}" Text="INCOMING" />
                <VerticalStackLayout Spacing="14"
                                     BindableLayout.ItemsSource="{Binding Incoming}"
                                     BindableLayout.ItemTemplate="{StaticResource ChallengeCardTemplate}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14" IsVisible="{Binding HasActive}">
                <Label Style="{StaticResource PxCaption}" Text="IN PROGRESS" />
                <VerticalStackLayout Spacing="14"
                                     BindableLayout.ItemsSource="{Binding Active}"
                                     BindableLayout.ItemTemplate="{StaticResource ChallengeCardTemplate}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14" IsVisible="{Binding HasOutgoing}">
                <Label Style="{StaticResource PxCaption}" Text="SENT" />
                <VerticalStackLayout Spacing="14"
                                     BindableLayout.ItemsSource="{Binding Outgoing}"
                                     BindableLayout.ItemTemplate="{StaticResource ChallengeCardTemplate}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14" IsVisible="{Binding HasHistory}">
                <Label Style="{StaticResource PxCaption}" Text="HISTORY" />
                <VerticalStackLayout Spacing="14"
                                     BindableLayout.ItemsSource="{Binding History}"
                                     BindableLayout.ItemTemplate="{StaticResource ChallengeCardTemplate}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
