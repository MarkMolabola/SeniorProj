<?xml version="1.0" encoding="utf-8" ?>
<!-- Month view of workouts, plus logging a past workout on a chosen day. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:MDRNJfitness.Helpers.Converters"
             xmlns:helpers="clr-namespace:MDRNJfitness.Helpers"
             x:Class="MDRNJfitness.Views.CalendarPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ContentPage.Resources>
        <conv:UtcToLocalConverter x:Key="UtcToLocal" />

        <Style x:Key="WeekdayLabel" TargetType="Label" BasedOn="{StaticResource PxCaption}">
            <Setter Property="HorizontalOptions" Value="Center" />
        </Style>

        <!-- Day cell: gold when selected, teal outline for today, teal pip when trained -->
        <DataTemplate x:Key="DayTemplate" x:DataType="helpers:CalendarDayItem">
            <Border Margin="2"
                    StrokeShape="Rectangle"
                    Stroke="{StaticResource PxInk}"
                    StrokeThickness="2"
                    BackgroundColor="{StaticResource PxPanelSunken}"
                    Padding="0"
                    HeightRequest="44">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource PxTeal}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource PxGold}" />
                    </DataTrigger>
                </Border.Triggers>

                <Grid>
                    <Label Text="{Binding Day}"
                           FontFamily="PixelBody"
                           FontSize="20"
                           TextColor="{StaticResource PxText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource PxGoldInk}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <BoxView WidthRequest="6" HeightRequest="6"
                             Color="{StaticResource PxTeal}"
                             VerticalOptions="End"
                             HorizontalOptions="Center"
                             Margin="0,0,0,4"
                             IsVisible="{Binding HasWorkout}">
                        <BoxView.Triggers>
                            <DataTrigger TargetType="BoxView" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Color" Value="{StaticResource PxGoldInk}" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="20">

            <Label Style="{StaticResource PxTitle}" Text="TRAINING LOG" />

            <!-- ── Badges ──────────────────────────────────────────── -->
            <Border Style="{StaticResource PxChip}" IsVisible="{Binding HasFiveDayStreakBadge}" BackgroundColor="#CD7F32">
                <Label Style="{StaticResource PxBody}" TextColor="{StaticResource PxInk}" Text="★ 5-DAY STREAK BADGE" />
            </Border>
            <Border Style="{StaticResource PxChip}" IsVisible="{Binding HasTenDayBadge}" BackgroundColor="#C9CCD6">
                <Label Style="{StaticResource PxBody}" TextColor="{StaticResource PxInk}" Text="★ 10-DAY WORKOUT BADGE" />
            </Border>
            <Border Style="{StaticResource PxChip}" IsVisible="{Binding HasTwentyDayBadge}">
                <Label Style="{StaticResource PxBody}" TextColor="{StaticResource PxGoldInk}" Text="★ 20-DAY WORKOUT BADGE" />
            </Border>

            <!-- ── Month grid ──────────────────────────────────────── -->
            <Border Style="{StaticResource PxPanel}" Padding="10,12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0"
                                Style="{StaticResource PxButtonSecondary}"
                                Text="◀"
                                Command="{Binding PreviousMonthCommand}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource PxHeading}"
                               Text="{Binding MonthLabel}"
                               TextTransform="Uppercase"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Style="{StaticResource PxButtonSecondary}"
                                Text="▶"
                                Command="{Binding NextMonthCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                        <Label Grid.Column="0" Style="{StaticResource WeekdayLabel}" Text="SU" />
                        <Label Grid.Column="1" Style="{StaticResource WeekdayLabel}" Text="MO" />
                        <Label Grid.Column="2" Style="{StaticResource WeekdayLabel}" Text="TU" />
                        <Label Grid.Column="3" Style="{StaticResource WeekdayLabel}" Text="WE" />
                        <Label Grid.Column="4" Style="{StaticResource WeekdayLabel}" Text="TH" />
                        <Label Grid.Column="5" Style="{StaticResource WeekdayLabel}" Text="FR" />
                        <Label Grid.Column="6" Style="{StaticResource WeekdayLabel}" Text="SA" />
                    </Grid>

                    <!-- Fixed height: iOS collapses a CollectionView inside a ScrollView. 6 rows x 48 (44 cell + margin) -->
                    <CollectionView x:Name="DaysGrid"
                                    HeightRequest="288"
                                    ItemsSource="{Binding Days}"
                                    ItemTemplate="{StaticResource DayTemplate}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnDaySelected">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="7" />
                        </CollectionView.ItemsLayout>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- ── Selected day ────────────────────────────────────── -->
            <Label Style="{StaticResource PxCaption}"
                   Text="{Binding SelectedDay.Date, StringFormat='{0:MMM d}'}"
                   TextTransform="Uppercase"
                   IsVisible="{Binding HasSelectedDay}" />

            <VerticalStackLayout Spacing="12"
                                 BindableLayout.ItemsSource="{Binding SelectedWorkouts}"
                                 IsVisible="{Binding HasSelectedDay}">
                <BindableLayout.EmptyView>
                    <Border Style="{StaticResource PxPanel}">
                        <Label Style="{StaticResource PxMuted}" Text="No training on this day." />
                    </Border>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PxPanel}" Padding="16,12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Style="{StaticResource PxBody}"
                                           Text="{Binding WorkoutType, Converter={StaticResource WorkoutTypeName}}"
                                           TextColor="{Binding WorkoutType, Converter={StaticResource WorkoutCategoryColor}}" />
                                    <Label Style="{StaticResource PxMuted}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span FontFamily="PixelBody" Text="{Binding StartTime, Converter={StaticResource UtcToLocal}, StringFormat='{0:h:mm tt}'}" />
                                                <Span FontFamily="PixelBody" Text=" · " />
                                                <Span FontFamily="PixelBody" Text="{Binding DurationMins, StringFormat='{0} min'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Style="{StaticResource PxXp}"
                                       Text="{Binding XPAwarded, StringFormat='+{0} XP'}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ── Log a past workout ──────────────────────────────── -->
            <Border Style="{StaticResource PxPanel}" IsVisible="{Binding HasSelectedDay}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PxHeading}" Text="LOG A SESSION" />

                    <Label Style="{StaticResource PxCaption}" Text="TYPE" />
                    <Border Style="{StaticResource PxSunken}"
                            Stroke="{Binding BacklogCategory, Converter={StaticResource WorkoutCategoryColor}}"
                            Padding="12,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeBacklogTypeCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Style="{StaticResource PxBody}"
                                   VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontFamily="PixelBody" Text="{Binding BacklogCategory}"
                                              TextColor="{Binding BacklogCategory, Converter={StaticResource WorkoutCategoryColor}}" />
                                        <Span FontFamily="PixelBody" Text="  ·  " />
                                        <Span FontFamily="PixelBody" Text="{Binding BacklogTypeName}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label Style="{StaticResource PxCaption}"
                                       Text="CHANGE"
                                       TextColor="{StaticResource PxGold}"
                                       VerticalOptions="Center" />
                                <Polygon Points="0,0 10,0 5,6"
                                         Fill="{StaticResource PxGold}"
                                         VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource PxCaption}" Text="START TIME" />
                        <Label Grid.Column="1" Style="{StaticResource PxCaption}" Text="MINUTES" />
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PxSunken}" Padding="10,0">
                            <TimePicker Time="{Binding BacklogTime}"
                                        FontFamily="PixelBody"
                                        FontSize="22"
                                        TextColor="{StaticResource PxText}"
                                        BackgroundColor="Transparent" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PxSunken}" Padding="10,0">
                            <Entry Style="{StaticResource PxEntry}"
                                   Text="{Binding BacklogDuration}"
                                   Keyboard="Numeric"
                                   Placeholder="30" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding BacklogTracksDistance}">
                        <Label Style="{StaticResource PxCaption}" Text="DISTANCE (KM) · OPTIONAL" />
                        <Border Style="{StaticResource PxSunken}" Padding="10,0">
                            <Entry Style="{StaticResource PxEntry}"
                                   Text="{Binding BacklogDistanceKm}"
                                   Keyboard="Numeric"
                                   Placeholder="e.g. 5.0" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Style="{StaticResource PxButton}"
                            Text="LOG SESSION"
                            Command="{Binding LogBacklogCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
