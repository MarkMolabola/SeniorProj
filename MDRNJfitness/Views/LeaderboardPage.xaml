<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.LeaderboardPage"
             Title="{Binding Title}"
             BackgroundColor="#F4FFF7">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label Text="Leaderboard"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#1F2937" />

            <Border BackgroundColor="White"
                    Stroke="#D9EAD3"
                    StrokeShape="RoundRectangle 16"
                    Padding="14">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Entries}">
                    <BindableLayout.EmptyView>
                        <Label Text="No leaderboard data yet."
                               FontSize="13"
                               TextColor="#6B7280" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#F9FAFB"
                                    Stroke="#E5E7EB"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <Grid ColumnDefinitions="40,*,Auto,Auto" ColumnSpacing="8">

                                    <!-- Rank -->
                                    <Label Grid.Column="0"
                                           Text="{Binding Rank}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#F97316"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />

                                    <!-- Name + username -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}"
                                               FontAttributes="Bold"
                                               TextColor="#1F2937" />
                                        <Label Text="{Binding Username, StringFormat='@{0}'}"
                                               FontSize="12"
                                               TextColor="#6B7280" />
                                    </VerticalStackLayout>

                                    <!-- Level -->
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                                        <Label Text="{Binding CurrentLevel}"
                                               FontAttributes="Bold"
                                               TextColor="#2563EB"
                                               HorizontalOptions="Center" />
                                        <Label Text="LVL"
                                               FontSize="10"
                                               TextColor="#6B7280"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>

                                    <!-- XP -->
                                    <VerticalStackLayout Grid.Column="3" HorizontalOptions="End" VerticalOptions="Center" Spacing="0">
                                        <Label Text="{Binding TotalXP}"
                                               FontAttributes="Bold"
                                               TextColor="#16A34A"
                                               HorizontalOptions="End" />
                                        <Label Text="XP"
                                               FontSize="10"
                                               TextColor="#6B7280"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
