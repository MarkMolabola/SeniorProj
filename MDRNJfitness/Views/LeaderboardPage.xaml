<?xml version="1.0" encoding="utf-8" ?>
<!-- Global XP rankings; top three get gold / silver / bronze. Tap a player to view their profile. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.LeaderboardPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="20">

            <Label Style="{StaticResource PxTitle}" Text="HALL OF FAME" />

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Entries}">
                <BindableLayout.EmptyView>
                    <Border Style="{StaticResource PxPanel}">
                        <Label Style="{StaticResource PxMuted}" Text="No rankings yet. Go earn some XP!" />
                    </Border>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PxPanel}" Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenProfileCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Rank}" Value="1">
                                    <Setter Property="Stroke" Value="{StaticResource PxGold}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="12">
                                <!-- Rank -->
                                <Border Grid.Column="0" Style="{StaticResource PxSunken}" Padding="0" HeightRequest="44">
                                    <Label Style="{StaticResource PxTitle}"
                                           FontSize="14"
                                           Text="{Binding Rank}"
                                           TextColor="{StaticResource PxTextMuted}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Rank}" Value="1">
                                                <Setter Property="TextColor" Value="{StaticResource PxGold}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Rank}" Value="2">
                                                <Setter Property="TextColor" Value="#C9CCD6" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Rank}" Value="3">
                                                <Setter Property="TextColor" Value="#CD7F32" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <!-- Name -->
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Style="{StaticResource PxBody}" Text="{Binding DisplayName}" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource PxMuted}" Text="{Binding Username, StringFormat='@{0}'}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <!-- Level -->
                                <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                                    <Label Style="{StaticResource PxBody}" Text="{Binding CurrentLevel}"
                                           TextColor="{StaticResource PxTeal}" HorizontalOptions="Center" />
                                    <Label Style="{StaticResource PxCaption}" Text="LV" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- XP -->
                                <VerticalStackLayout Grid.Column="3" Spacing="0" VerticalOptions="Center">
                                    <Label Style="{StaticResource PxXp}" Text="{Binding TotalXP}" HorizontalOptions="End" />
                                    <Label Style="{StaticResource PxCaption}" Text="XP" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
