<?xml version="1.0" encoding="utf-8" ?>
<!-- Shop: special heroes, then gear, 3 per row, bought with gold. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MDRNJfitness.Views"
             xmlns:vm="clr-namespace:MDRNJfitness.ViewModels"
             x:Class="MDRNJfitness.Views.ShopPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <CollectionView ItemsSource="{Binding Groups}"
                    IsGrouped="True"
                    SelectionMode="None"
                    Margin="14,0">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <VerticalStackLayout Padding="6,24,6,16" Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource PxTitle}" Text="SHOP" VerticalOptions="Center" />
                    <Border Grid.Column="1" Style="{StaticResource PxChip}" Padding="10,2">
                        <HorizontalStackLayout Spacing="6">
                            <Image Source="icon_gold.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Style="{StaticResource PxBody}" Text="{Binding GoldText}" TextColor="{StaticResource PxGoldInk}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
                <Label Style="{StaticResource PxMuted}" Text="Spend gold on heroes and gear. Earn gold from workouts, quests, duels, the dungeon and level-ups." />
                <Border Style="{StaticResource PxPanel}" IsVisible="{Binding HasNothingForSale}">
                    <Label Style="{StaticResource PxMuted}" Text="The shop is restocking. Check back soon!" />
                </Border>
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <VerticalStackLayout Padding="6,10,6,8" Spacing="2">
                    <Label Style="{StaticResource PxHeading}" Text="{Binding Name}" />
                    <Label Style="{StaticResource PxMuted}" FontSize="17" Text="{Binding Hint}" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource PxPanel}" Padding="8,10" Stroke="{Binding RarityBrush}" StrokeThickness="3">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Owned}" Value="True">
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ShopViewModel}}, Path=BuyCommand}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="6">
                        <Border Style="{StaticResource PxSunken}" Padding="6" HeightRequest="72">
                            <Grid>
                                <local:GearIconView ItemId="{Binding Id}" IsVisible="{Binding IsGear}" />
                                <local:PixelAvatarView AvatarId="{Binding Id}" IsVisible="{Binding IsHero}"
                                                       WidthRequest="64" HeightRequest="64"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Style="{StaticResource PxBody}" FontSize="18" Text="{Binding Name}"
                               HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                        <Label Style="{StaticResource PxCaption}" Text="{Binding RarityName}" TextColor="{Binding RarityColor}" HorizontalOptions="Center" />
                        <Label Style="{StaticResource PxBody}" FontSize="17" Text="{Binding BonusText}" TextColor="{StaticResource PxTeal}"
                               HorizontalTextAlignment="Center" HorizontalOptions="Center" MaxLines="3" />

                        <!-- Price / owned -->
                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                            <HorizontalStackLayout.Triggers>
                                <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding Owned}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </HorizontalStackLayout.Triggers>
                            <Image Source="icon_gold.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Style="{StaticResource PxBody}" FontSize="19" Text="{Binding Price}"
                                   TextColor="{StaticResource PxGold}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding CanAfford}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource PxTextDim}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource PxCaption}" Text="OWNED" TextColor="{StaticResource PxTeal}"
                               HorizontalOptions="Center" IsVisible="{Binding Owned}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="24" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
