<?xml version="1.0" encoding="utf-8" ?>
<!-- Add friends, answer requests, and browse your party. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.FriendsPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="20">

            <Label Style="{StaticResource PxTitle}" Text="PARTY" />

            <!-- ── Add friend ──────────────────────────────────────── -->
            <Border Style="{StaticResource PxPanel}">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource PxHeading}" Text="RECRUIT A FRIEND" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource PxSunken}" Padding="10,0">
                            <Entry Style="{StaticResource PxEntry}"
                                   Placeholder="Username"
                                   Text="{Binding SearchUsername}" />
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource PxButton}"
                                Text="SEND"
                                Command="{Binding SendRequestCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ── Pending requests ───────────────────────────────── -->
            <VerticalStackLayout Spacing="12">
                <Label Style="{StaticResource PxCaption}" Text="REQUESTS" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding PendingRequests}">
                    <BindableLayout.EmptyView>
                        <Label Style="{StaticResource PxMuted}" Text="No pending requests." />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PxPanelHighlight}" Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource PxBody}"
                                           Text="{Binding Username}"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource PxButtonSecondary}"
                                            Text="✕"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeclineCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource PxButton}"
                                            FontSize="10"
                                            Padding="12,10"
                                            MinimumHeightRequest="44"
                                            Text="ACCEPT"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AcceptCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ── Friends ─────────────────────────────────────────── -->
            <VerticalStackLayout Spacing="12">
                <Label Style="{StaticResource PxCaption}" Text="FRIENDS" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Friends}">
                    <BindableLayout.EmptyView>
                        <Border Style="{StaticResource PxPanel}">
                            <Label Style="{StaticResource PxMuted}" Text="No friends yet. Send a request above!" />
                        </Border>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PxPanel}" Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource PxBody}"
                                           Text="{Binding Username}"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource PxButtonSecondary}"
                                            Text="VIEW"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewProfileCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
