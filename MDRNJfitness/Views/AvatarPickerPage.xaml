<?xml version="1.0" encoding="utf-8" ?>
<!-- CUSTOMIZE pop-up: tap a hero to equip it (or unlock it). BindingContext is the Hero tab's CharacterViewModel. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:local="clr-namespace:MDRNJfitness.Views"
             xmlns:vm="clr-namespace:MDRNJfitness.ViewModels"
             x:Class="MDRNJfitness.Views.AvatarPickerPage"
             ios:Page.ModalPresentationStyle="OverFullScreen"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#E60B0918">

    <Grid Padding="16,40">
        <Border Style="{StaticResource PxPanel}" Padding="14,16" VerticalOptions="Center">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Style="{StaticResource PxHeading}" Text="CHOOSE YOUR HERO" VerticalOptions="Center" />
                    <Button Grid.Column="1" Style="{StaticResource PxButtonSecondary}" Text="✕"
                            Command="{Binding ClosePopupCommand}" />
                </Grid>

                <Label Grid.Row="1" Style="{StaticResource PxMuted}" FontSize="17"
                       Text="The Classic Hero is free, wears your gear, and its outfit changes as you train. Special heroes are unlocked with gold and come dressed in their own outfit and stat boosts." />

                <CollectionView Grid.Row="2"
                                ItemsSource="{Binding AvatarOptions}"
                                SelectionMode="None"
                                MaximumHeightRequest="520">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PxSunken}" Padding="6,8"
                                    Stroke="{Binding RarityBrush}" StrokeThickness="2">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource PxGold}" />
                                        <Setter Property="StrokeThickness" Value="3" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CharacterViewModel}}, Path=SelectAvatarCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="4">
                                    <local:PixelAvatarView AvatarId="{Binding Id}"
                                                           AvatarType="{Binding PreviewOutfit}"
                                                           Gear="{Binding PreviewGear}"
                                                           WidthRequest="64"
                                                           HeightRequest="64"
                                                           HorizontalOptions="Center">
                                        <local:PixelAvatarView.Triggers>
                                            <DataTrigger TargetType="local:PixelAvatarView" Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </local:PixelAvatarView.Triggers>
                                    </local:PixelAvatarView>
                                    <Label Style="{StaticResource PxBody}" FontSize="16" Text="{Binding Name}"
                                           HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource PxCaption}" FontSize="7" Text="EQUIPPED"
                                           TextColor="{StaticResource PxGold}" HorizontalOptions="Center"
                                           IsVisible="{Binding IsSelected}" />
                                    <HorizontalStackLayout Spacing="3" HorizontalOptions="Center" IsVisible="{Binding IsLocked}">
                                        <Label Text="🔒" FontSize="12" VerticalOptions="Center" />
                                        <Image Source="icon_gold.png" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                                        <Label Style="{StaticResource PxBody}" FontSize="15" Text="{Binding PriceText}"
                                               TextColor="{StaticResource PxGold}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
