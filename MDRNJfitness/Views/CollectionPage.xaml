<?xml version="1.0" encoding="utf-8" ?>
<!-- Owned gear, 3 per row. Tap an item to wear it (or take it off). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MDRNJfitness.Views"
             xmlns:vm="clr-namespace:MDRNJfitness.ViewModels"
             x:Class="MDRNJfitness.Views.CollectionPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <CollectionView ItemsSource="{Binding Items}"
                    SelectionMode="None"
                    Margin="14,0">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <VerticalStackLayout Padding="6,24,6,16" Spacing="14">
                <Label Style="{StaticResource PxTitle}" Text="COLLECTION" />
                <Label Style="{StaticResource PxMuted}" Text="Tap an item to wear it. Tap it again to take it off." />
                <Border Style="{StaticResource PxPanel}" IsVisible="{Binding HasNothing}">
                    <Label Style="{StaticResource PxMuted}" Text="Nothing here yet. Visit the Shop on the Home tab to buy gear!" />
                </Border>
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource PxPanel}" Padding="8,10">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Equipped}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource PxGold}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CollectionViewModel}}, Path=ToggleEquipCommand}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="6">
                        <Border Style="{StaticResource PxSunken}" Padding="6" HeightRequest="72">
                            <local:GearIconView ItemId="{Binding Item.Id}" />
                        </Border>
                        <Label Style="{StaticResource PxBody}" FontSize="18" Text="{Binding Item.Name}"
                               HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                        <Label Style="{StaticResource PxCaption}" Text="{Binding SlotName}" HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Equipped}" Value="True">
                                    <Setter Property="Text" Value="EQUIPPED" />
                                    <Setter Property="TextColor" Value="{StaticResource PxGold}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="24" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
