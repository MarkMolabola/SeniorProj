<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.PixelAvatarView"
             WidthRequest="160"
             HeightRequest="160">

    <!--
        Default 160 × 160 = the 32 × 32 hero at 5×. The canvas fills the view
        and the drawable picks the largest whole-number scale that fits, so
        use multiples of 32 (96, 128, 160, 192…) for an exact fit.
    -->
    <!-- InputTransparent: taps reach whatever card the hero sits in -->
    <GraphicsView x:Name="AvatarCanvas"
                  InputTransparent="True"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill" />

</ContentView>
