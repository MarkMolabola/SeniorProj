<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.PixelAvatarView">

    <!--
        80 × 128 = 10 sprite cols × 8  ×  16 sprite rows × 8
        Rendered with crisp nearest-neighbour scaling via GraphicsView.
    -->
    <GraphicsView x:Name="AvatarCanvas"
                  WidthRequest="80"
                  HeightRequest="128"
                  HorizontalOptions="Center" />

</ContentView>
