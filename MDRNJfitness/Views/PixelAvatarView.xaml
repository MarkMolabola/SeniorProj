<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.PixelAvatarView">

    <!--
        160 × 256 = 10 sprite cols × 16  ×  16 sprite rows × 16
        Rendered with crisp nearest-neighbour scaling via GraphicsView.
    -->
    <GraphicsView x:Name="AvatarCanvas"
                  WidthRequest="160"
                  HeightRequest="256"
                  HorizontalOptions="Center" />

</ContentView>
