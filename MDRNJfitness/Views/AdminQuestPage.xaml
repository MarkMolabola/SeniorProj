<?xml version="1.0" encoding="utf-8" ?>
<!-- Admin: create, edit, send and delete quests. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MDRNJfitness.Views.AdminQuestPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="20">

            <Button Style="{StaticResource PxButtonSecondary}"
                    Text="◀ BACK"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />

            <Label Style="{StaticResource PxTitle}" Text="QUEST MASTER" />

            <!-- ── Create / edit ───────────────────────────────────── -->
            <Border Style="{StaticResource PxPanelHighlight}">
                <VerticalStackLayout Spacing="10">

                    <Label Style="{StaticResource PxHeading}" Text="NEW QUEST"
                           IsVisible="{Binding IsEditing, Converter={x:StaticResource InverseBoolConverter}}" />
                    <Label Style="{StaticResource PxHeading}" Text="EDIT QUEST"
                           IsVisible="{Binding IsEditing}" />

                    <Label Style="{StaticResource PxCaption}" Text="TITLE" />
                    <Border Style="{StaticResource PxSunken}" Padding="10,0">
                        <Entry Style="{StaticResource PxEntry}" Placeholder="Run 3 times this week" Text="{Binding FormTitle}" />
                    </Border>

                    <Label Style="{StaticResource PxCaption}" Text="DESCRIPTION" />
                    <Border Style="{StaticResource PxSunken}" Padding="10,0">
                        <Editor Placeholder="Optional"
                                Text="{Binding FormDescription}"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="60"
                                FontFamily="PixelBody"
                                FontSize="22"
                                TextColor="{StaticResource PxText}"
                                PlaceholderColor="{StaticResource PxTextDim}"
                                BackgroundColor="Transparent" />
                    </Border>

                    <Label Style="{StaticResource PxCaption}" Text="QUEST TYPE" />
                    <Border Style="{StaticResource PxSunken}" Padding="10,0">
                        <Picker Style="{StaticResource PxPicker}"
                                ItemsSource="{Binding QuestTypes}"
                                SelectedItem="{Binding FormQuestType}" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource PxCaption}" Text="XP REWARD" />
                        <Label Grid.Column="1" Style="{StaticResource PxCaption}" Text="TARGET" />
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PxSunken}" Padding="10,0">
                            <Entry Style="{StaticResource PxEntry}" Placeholder="100" Text="{Binding FormXPReward}" Keyboard="Numeric" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PxSunken}" Padding="10,0">
                            <Entry Style="{StaticResource PxEntry}" Placeholder="3" Text="{Binding FormTargetValue}" Keyboard="Numeric" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Label Grid.Column="0" Style="{StaticResource PxCaption}" Text="STARTS" />
                        <Label Grid.Column="1" Style="{StaticResource PxCaption}" Text="ENDS" />
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PxSunken}" Padding="10,0">
                            <DatePicker Date="{Binding FormStartDate}" FontFamily="PixelBody" FontSize="22"
                                        TextColor="{StaticResource PxText}" BackgroundColor="Transparent" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PxSunken}" Padding="10,0">
                            <DatePicker Date="{Binding FormEndDate}" FontFamily="PixelBody" FontSize="22"
                                        TextColor="{StaticResource PxText}" BackgroundColor="Transparent" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Style="{StaticResource PxButtonSecondary}"
                                Text="CANCEL"
                                IsVisible="{Binding IsEditing}"
                                Command="{Binding CancelEditCommand}" />
                        <Button Grid.Column="0" Grid.ColumnSpan="2"
                                Style="{StaticResource PxButton}"
                                Text="CREATE QUEST"
                                IsVisible="{Binding IsEditing, Converter={x:StaticResource InverseBoolConverter}}"
                                Command="{Binding SaveCommand}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource PxButton}"
                                Text="UPDATE"
                                IsVisible="{Binding IsEditing}"
                                Command="{Binding SaveCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ── All quests ──────────────────────────────────────── -->
            <VerticalStackLayout Spacing="12">
                <Label Style="{StaticResource PxCaption}" Text="ALL QUESTS" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Quests}">
                    <BindableLayout.EmptyView>
                        <Border Style="{StaticResource PxPanel}">
                            <Label Style="{StaticResource PxMuted}" Text="No quests created yet." />
                        </Border>
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PxPanel}">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" Style="{StaticResource PxHeading}"
                                               Text="{Binding Title}" TextTransform="Uppercase" />
                                        <Label Grid.Column="1" Style="{StaticResource PxXp}" VerticalOptions="Start"
                                               Text="{Binding XPReward, StringFormat='+{0} XP'}" />
                                    </Grid>
                                    <Label Style="{StaticResource PxMuted}" Text="{Binding Description}" />
                                    <Label Style="{StaticResource PxBody}" FontSize="19" TextColor="{StaticResource PxTeal}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding QuestType}" />
                                                <Span Text=" · target " />
                                                <Span Text="{Binding TargetValue, StringFormat='{0:0.#}'}" />
                                                <Span Text=" · " />
                                                <Span Text="{Binding AssignedCount, StringFormat='{0} assigned'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Style="{StaticResource PxButtonSecondary}"
                                                Text="EDIT"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StartEditCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource PxButtonSecondary}"
                                                Text="SEND ALL"
                                                TextColor="{StaticResource PxTeal}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SendToAllCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource PxButtonSecondary}"
                                                Text="DELETE"
                                                TextColor="{StaticResource PxStr}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
