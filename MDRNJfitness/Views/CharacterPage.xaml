<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MDRNJfitness.Views"
             x:Class="MDRNJfitness.Views.CharacterPage"
             Title="{Binding Title}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Character card -->
                <Border StrokeShape="RoundRectangle 12" Padding="24">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <local:PixelAvatarView AvatarType="{Binding SpriteState}"
                                               HorizontalOptions="Center" />
                        <Label Text="{Binding SpriteState}"
                               FontSize="14" FontAttributes="Bold"
                               TextTransform="Uppercase"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Character details -->
                <Border StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Character Details" FontAttributes="Bold" FontSize="16" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Body Type" FontSize="12" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding CharacterState.BodyType}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Outfit" FontSize="12" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding CharacterState.OutfitSlot}" FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Equipment" FontSize="12" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding CharacterState.EquipmentSlot}" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Activity scores -->
                <Border StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Activity Scores" FontAttributes="Bold" FontSize="16" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="Strength" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding ActivityScore.StrengthScore, StringFormat='{0:F1}'}"
                                   FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Cardio" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ActivityScore.CardioScore, StringFormat='{0:F1}'}"
                                   FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Flexibility" />
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding ActivityScore.FlexibilityScore, StringFormat='{0:F1}'}"
                                   FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </Grid>
                        <Label Text="{Binding ActivityScore.DominantSport, StringFormat='Dominant: {0}'}"
                               FontSize="12" TextColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Evolve -->
                <Button Text="Evolve Character"
                        Command="{Binding EvolveCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
