<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MDRNJfitness.Views"
             xmlns:controls="clr-namespace:MDRNJfitness.Controls"
             xmlns:vm="clr-namespace:MDRNJfitness.ViewModels"
             x:Class="MDRNJfitness.Views.CharacterPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="24">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Style="{StaticResource PxTitle}" Text="HERO" VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource PxButtonSecondary}"
                        Text="CUSTOMIZE"
                        Command="{Binding ToggleCustomizeCommand}" />
            </Grid>

            <!-- Stage -->
            <Border Style="{StaticResource PxPanel}" BackgroundColor="{StaticResource PxPanelSunken}" Padding="0" HeightRequest="300">
                <Grid RowDefinitions="*,40">
                    <BoxView Grid.Row="1" Color="{StaticResource PxPanelRaised}" />
                    <BoxView Grid.Row="1" HeightRequest="3" VerticalOptions="Start" Color="{StaticResource PxInk}" />
                    <local:PixelAvatarView Grid.RowSpan="2"
                                           AvatarType="{Binding SpriteState}"
                                           AvatarId="{Binding AvatarId}"
                                           Gear="{Binding HeroGear}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End"
                                           Margin="0,0,0,24" />
                </Grid>
            </Border>

            <!-- Customize: pick a hero look -->
            <Border Style="{StaticResource PxPanelHighlight}" IsVisible="{Binding IsCustomizing}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PxHeading}" Text="CHOOSE YOUR HERO" />
                    <Label Style="{StaticResource PxMuted}"
                           Text="Looks are cosmetic: your stats and progress stay the same. The Classic Hero's outfit changes as you train." />

                    <FlexLayout BindableLayout.ItemsSource="{Binding AvatarOptions}"
                                Wrap="Wrap"
                                JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PxSunken}"
                                        Padding="10"
                                        Margin="0,0,12,12"
                                        WidthRequest="136">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource PxGold}" />
                                            <Setter Property="StrokeThickness" Value="3" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CharacterViewModel}}, Path=SelectAvatarCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="6">
                                        <local:PixelAvatarView AvatarId="{Binding Id}"
                                                               AvatarType="{Binding PreviewOutfit}"
                                                               Gear="{Binding PreviewGear}"
                                                               WidthRequest="96"
                                                               HeightRequest="96"
                                                               HorizontalOptions="Center" />
                                        <Label Style="{StaticResource PxBody}"
                                               FontSize="19"
                                               Text="{Binding Name}"
                                               HorizontalOptions="Center" />
                                        <Label Style="{StaticResource PxCaption}"
                                               Text="EQUIPPED"
                                               TextColor="{StaticResource PxGold}"
                                               HorizontalOptions="Center"
                                               IsVisible="{Binding IsSelected}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Style="{StaticResource PxHeading}"
                       Text="{Binding CharacterState.BodyType, Converter={StaticResource BodyTypeName}}"
                       TextTransform="Uppercase"
                       HorizontalOptions="Center" />
                <Label Style="{StaticResource PxBody}"
                       TextColor="{StaticResource PxTeal}"
                       Text="{Binding ActivityScore.DominantSport, StringFormat='Dominant: {0}'}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Stats -->
            <Border Style="{StaticResource PxPanel}">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource PxHeading}" Text="STATS" />
                    <Grid ColumnDefinitions="52,*,64" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource PxHeading}" FontSize="10"
                               TextColor="{StaticResource PxStr}" Text="STR" VerticalOptions="Center" />
                        <controls:XPBarControl Grid.Row="0" Grid.Column="1" HeightRequest="16" VerticalOptions="Center"
                                               FillColor="{StaticResource PxStr}"
                                               Progress="{Binding ActivityScore.StrengthPoints, Converter={StaticResource StatLevelProgress}}" />
                        <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource PxBody}" HorizontalTextAlignment="End"
                               Text="{Binding ActivityScore.StrengthPoints, Converter={StaticResource StatLevel}, StringFormat='Lv {0}'}" />

                        <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource PxHeading}" FontSize="10"
                               TextColor="{StaticResource PxTeal}" Text="END" VerticalOptions="Center" />
                        <controls:XPBarControl Grid.Row="1" Grid.Column="1" HeightRequest="16" VerticalOptions="Center"
                                               FillColor="{StaticResource PxTeal}"
                                               Progress="{Binding ActivityScore.CardioPoints, Converter={StaticResource StatLevelProgress}}" />
                        <Label Grid.Row="1" Grid.Column="2" Style="{StaticResource PxBody}" HorizontalTextAlignment="End"
                               Text="{Binding ActivityScore.CardioPoints, Converter={StaticResource StatLevel}, StringFormat='Lv {0}'}" />

                        <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource PxHeading}" FontSize="10"
                               TextColor="{StaticResource PxFlx}" Text="FLX" VerticalOptions="Center" />
                        <controls:XPBarControl Grid.Row="2" Grid.Column="1" HeightRequest="16" VerticalOptions="Center"
                                               FillColor="{StaticResource PxFlx}"
                                               Progress="{Binding ActivityScore.FlexibilityPoints, Converter={StaticResource StatLevelProgress}}" />
                        <Label Grid.Row="2" Grid.Column="2" Style="{StaticResource PxBody}" HorizontalTextAlignment="End"
                               Text="{Binding ActivityScore.FlexibilityPoints, Converter={StaticResource StatLevel}, StringFormat='Lv {0}'}" />
                    </Grid>
                    <Label Style="{StaticResource PxMuted}" FontSize="17"
                           Text="STR = Strength · END = Cardio · FLX = Flexibility. Stats grow from workouts, quests and challenges." />
                </VerticalStackLayout>
            </Border>

            <!-- Gear: tap a slot to wear something you own -->
            <Border Style="{StaticResource PxPanel}">
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource PxHeading}" Text="GEAR" />

                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6"
                          BindableLayout.ItemsSource="{Binding GearSlots}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Grid.Column="{Binding Slot, Converter={StaticResource GearSlotColumn}}"
                                                     Spacing="4">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CharacterViewModel}}, Path=ChooseGearCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>

                                    <Border Style="{StaticResource PxSunken}" HeightRequest="58" Padding="6">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEmpty}" Value="False">
                                                <Setter Property="Stroke" Value="{StaticResource PxGold}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid>
                                            <local:GearIconView ItemId="{Binding ItemId}" />
                                            <Label Text="+" FontFamily="PixelBody" FontSize="28"
                                                   TextColor="{StaticResource PxTextDim}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   IsVisible="{Binding IsEmpty}" />
                                        </Grid>
                                    </Border>
                                    <Label Style="{StaticResource PxMuted}" FontSize="16" Text="{Binding Label}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>

                    <Label Style="{StaticResource PxMuted}"
                           FontSize="17"
                           TextColor="{StaticResource PxOrange}"
                           IsVisible="{Binding HasHiddenGear}"
                           Text="Some of your gear hasn't been drawn for this hero yet, so it's hidden. It still shows on heroes it fits." />

                    <Label Style="{StaticResource PxMuted}" FontSize="17">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Training outfit: " />
                                <Span Text="{Binding CharacterState.OutfitSlot}" TextColor="{StaticResource PxTeal}" />
                                <Span Text=" · Build: " />
                                <Span Text="{Binding CharacterState.BodyType, Converter={StaticResource BodyTypeName}}" TextColor="{StaticResource PxTeal}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Evolution happens automatically as training shifts -->
            <VerticalStackLayout Spacing="4">
                <Label Style="{StaticResource PxMuted}"
                       Text="Your hero evolves on its own as your training changes."
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />
                <Label Style="{StaticResource PxMuted}"
                       FontSize="17"
                       TextColor="{StaticResource PxTextDim}"
                       Text="{Binding CharacterState.LastEvolved, StringFormat='Last evolved {0:MMM d, yyyy}'}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
