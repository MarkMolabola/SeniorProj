<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.QuestPage"
             Title="{Binding Title}"
             BackgroundColor="#F4FFF7">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Quests"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Admin Panel"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="12,8"
                        IsVisible="{Binding IsAdmin}"
                        Clicked="OnAdminPanelClicked" />
            </Grid>

            <!-- Active Quests -->
            <Border BackgroundColor="White"
                    Stroke="#D9EAD3"
                    StrokeShape="RoundRectangle 16"
                    Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="My Quests"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1F2937" />

                    <Label Text="No quests assigned yet."
                           FontSize="13"
                           TextColor="#6B7280"
                           IsVisible="{Binding HasNoQuests}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Quests}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F9FAFB"
                                        Stroke="#E5E7EB"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Title}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#1F2937" />

                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding XPReward, StringFormat='+{0} XP'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#16A34A"
                                               VerticalOptions="Center" />

                                        <Label Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding Description}"
                                               FontSize="13"
                                               TextColor="#6B7280" />

                                        <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                                            <Label Text="{Binding Status}"
                                                   FontSize="12"
                                                   TextColor="#2563EB"
                                                   FontAttributes="Bold" />
                                            <Label FontSize="11"
                                                   TextColor="#9CA3AF">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Progress}" />
                                                        <Span Text=" / " />
                                                        <Span Text="{Binding TargetValue}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
