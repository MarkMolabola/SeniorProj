<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MDRNJfitness.Controls"
             x:Class="MDRNJfitness.Views.QuestPage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="24">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Style="{StaticResource PxTitle}"
                       Text="QUEST BOARD"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource PxButtonSecondary}"
                        Text="ADMIN"
                        IsVisible="{Binding IsAdmin}"
                        Clicked="OnAdminPanelClicked" />
            </Grid>

            <Border Style="{StaticResource PxPanel}" IsVisible="{Binding HasNoQuests}">
                <Label Style="{StaticResource PxMuted}"
                       Text="No quests on the board yet. Check back soon!" />
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Quests}" Spacing="24">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PxPanel}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                    <Setter Property="Stroke" Value="{StaticResource PxGold}" />
                                    <Setter Property="BackgroundColor" Value="#2B2656" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Expired">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Border.Triggers>

                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource PxHeading}"
                                           Text="{Binding Title}"
                                           TextTransform="Uppercase" />
                                    <Label Grid.Column="1"
                                           Style="{StaticResource PxXp}"
                                           VerticalOptions="Start"
                                           Text="{Binding XPReward, StringFormat='+{0} XP'}" />
                                </Grid>

                                <Label Style="{StaticResource PxMuted}" Text="{Binding Description}" />
                                <Label Style="{StaticResource PxBody}" FontSize="19" TextColor="{StaticResource PxOrange}"
                                       Text="{Binding WorkoutType, StringFormat='Counts: {0} workouts only'}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding WorkoutType}" Value="Any">
                                            <Setter Property="Text" Value="Counts: any workout" />
                                            <Setter Property="TextColor" Value="{StaticResource PxTextMuted}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <controls:XPBarControl HeightRequest="14"
                                                       FillColor="{StaticResource PxTeal}"
                                                       Segmented="False">
                                    <controls:XPBarControl.Progress>
                                        <MultiBinding Converter="{StaticResource RatioToProgress}">
                                            <Binding Path="Progress" />
                                            <Binding Path="TargetValue" />
                                        </MultiBinding>
                                    </controls:XPBarControl.Progress>
                                </controls:XPBarControl>

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Style="{StaticResource PxBody}"
                                           FontSize="19"
                                           TextColor="{StaticResource PxTeal}"
                                           Text="{Binding Status}"
                                           TextTransform="Uppercase">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                <Setter Property="Text" Value="✓ COMPLETE" />
                                                <Setter Property="TextColor" Value="{StaticResource PxGold}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Expired">
                                                <Setter Property="TextColor" Value="{StaticResource PxTextDim}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Column="1" Style="{StaticResource PxMuted}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Progress, StringFormat='{0:0.#}'}" />
                                                <Span Text=" / " />
                                                <Span Text="{Binding TargetValue, StringFormat='{0:0.#}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
