<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.ProfilePage"
             Title="{Binding Title}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Avatar + name -->
                <Border StrokeShape="RoundRectangle 12" Padding="24">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Ellipse Fill="{StaticResource Primary}"
                                 WidthRequest="80" HeightRequest="80"
                                 HorizontalOptions="Center" />
                        <Label Text="{Binding Profile.DisplayName}"
                               FontSize="22" FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding CurrentUser.Username, StringFormat='@{0}'}"
                               FontSize="14" TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Profile.Bio}"
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Stats -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 10" Padding="8">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding Stats.CurrentLevel}"
                                   FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Level" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 10" Padding="8">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding Stats.TotalXP}"
                                   FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Total XP" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 10" Padding="8">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding Stats.CurrentStreak}"
                                   FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="Streak" FontSize="11" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Profile details -->
                <Border StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Details" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="Fitness Goal" FontSize="12" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Profile.FitnessGoal}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Weight" FontSize="12" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Profile.WeightKg, StringFormat='{0} kg'}" FontAttributes="Bold" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Height" FontSize="12" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Profile.HeightCm, StringFormat='{0} cm'}" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Logout -->
                <Button Text="Log Out"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="#EF4444" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
