<?xml version="1.0" encoding="utf-8" ?>
<!-- Account details, body stats, and log out. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MDRNJfitness.Views.ProfilePage"
             Title="{Binding Title}"
             Style="{StaticResource PxPage}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="20">

            <Label Style="{StaticResource PxTitle}" Text="PROFILE" />

            <!-- ── Name card ───────────────────────────────────────── -->
            <Border Style="{StaticResource PxPanel}">
                <VerticalStackLayout Spacing="4">
                    <Label Style="{StaticResource PxHeading}"
                           Text="{Binding Profile.DisplayName}"
                           TextTransform="Uppercase" />
                    <Label Style="{StaticResource PxBody}"
                           Text="{Binding CurrentUser.Username, StringFormat='@{0}'}"
                           TextColor="{StaticResource PxTeal}" />
                    <Label Style="{StaticResource PxMuted}" Text="{Binding Profile.Bio}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Stats ───────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Style="{StaticResource PxSunken}" Padding="8,12">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Style="{StaticResource PxStatValue}" Text="{Binding Stats.CurrentLevel}"
                               TextColor="{StaticResource PxGold}" HorizontalOptions="Center" />
                        <Label Style="{StaticResource PxCaption}" Text="LEVEL" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PxSunken}" Padding="8,12">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Style="{StaticResource PxStatValue}" Text="{Binding Stats.TotalXP}"
                               TextColor="{StaticResource PxTeal}" HorizontalOptions="Center" />
                        <Label Style="{StaticResource PxCaption}" Text="TOTAL XP" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PxSunken}" Padding="8,12">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Style="{StaticResource PxStatValue}" Text="{Binding Stats.CurrentStreak}"
                               TextColor="{StaticResource PxOrange}" HorizontalOptions="Center" />
                        <Label Style="{StaticResource PxCaption}" Text="STREAK" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ── Details ─────────────────────────────────────────── -->
            <Border Style="{StaticResource PxPanel}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource PxHeading}" Text="DETAILS" VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource PxButtonSecondary}"
                                Text="EDIT"
                                Command="{Binding StartEditCommand}"
                                IsVisible="{Binding IsNotEditing}" />
                    </Grid>

                    <!-- Read view -->
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="8"
                          IsVisible="{Binding IsNotEditing}">
                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource PxMuted}" Text="Fitness goal" />
                        <Label Grid.Row="0" Grid.Column="1" Style="{StaticResource PxBody}" Text="{Binding Profile.FitnessGoal}" />
                        <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource PxMuted}" Text="Weight" />
                        <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource PxBody}" Text="{Binding Profile.WeightKg, StringFormat='{0} kg'}" />
                        <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource PxMuted}" Text="Height" />
                        <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource PxBody}" Text="{Binding Profile.HeightCm, StringFormat='{0} cm'}" />
                    </Grid>

                    <!-- Edit view -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEditing}">
                        <Label Style="{StaticResource PxCaption}" Text="FITNESS GOAL" />
                        <Border Style="{StaticResource PxSunken}" Padding="10,0">
                            <Picker Style="{StaticResource PxPicker}"
                                    ItemsSource="{Binding FitnessGoals}"
                                    SelectedItem="{Binding EditFitnessGoal}" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Label Grid.Column="0" Style="{StaticResource PxCaption}" Text="WEIGHT (KG)" />
                            <Label Grid.Column="1" Style="{StaticResource PxCaption}" Text="HEIGHT (CM)" />
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PxSunken}" Padding="10,0">
                                <Entry Style="{StaticResource PxEntry}" Text="{Binding EditWeight}" Keyboard="Numeric" Placeholder="70.5" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PxSunken}" Padding="10,0">
                                <Entry Style="{StaticResource PxEntry}" Text="{Binding EditHeight}" Keyboard="Numeric" Placeholder="175" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Style="{StaticResource PxButtonSecondary}"
                                    Text="CANCEL"
                                    Command="{Binding CancelEditCommand}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource PxButton}"
                                    Text="SAVE"
                                    Command="{Binding SaveProfileCommand}"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Style="{StaticResource PxButtonSecondary}"
                    Text="BLOCKED PLAYERS"
                    Command="{Binding ManageBlockedCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Button Style="{StaticResource PxButtonDanger}"
                    Text="LOG OUT"
                    Command="{Binding LogoutCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Button Style="{StaticResource PxLinkButton}"
                    Text="Delete account"
                    TextColor="{StaticResource PxStr}"
                    HorizontalOptions="Center"
                    Command="{Binding DeleteAccountCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Grid ColumnDefinitions="*,*" Margin="0,-8,0,0">
                <Button Style="{StaticResource PxLinkButton}"
                        Text="Terms of Service"
                        TextColor="{StaticResource PxTextMuted}"
                        Command="{Binding OpenTermsCommand}" />
                <Button Grid.Column="1"
                        Style="{StaticResource PxLinkButton}"
                        Text="Privacy Policy"
                        TextColor="{StaticResource PxTextMuted}"
                        Command="{Binding OpenPrivacyCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
