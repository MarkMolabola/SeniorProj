<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MDRNJfitness.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MDRNJfitness.Views"
    Title="MDRNJfitness">

    <!-- Login shown on first launch; after login navigate to //DashboardPage -->
    <ShellContent
        Title="Login"
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Shell.NavBarIsVisible="False" />

    <!--
        Main navigation: 5 bottom tabs. Tabs with several pages show them as
        top sub-tabs. Page routes are unchanged, so //WorkoutPage etc. still work.
    -->
    <TabBar>
        <Tab Title="Home" Route="home" Icon="tab_home.png">
            <ShellContent
                Route="DashboardPage"
                ContentTemplate="{DataTemplate views:DashboardPage}" />
        </Tab>
        <Tab Title="Train" Route="train" Icon="tab_train.png">
            <ShellContent
                Title="Workout"
                Route="WorkoutPage"
                ContentTemplate="{DataTemplate views:WorkoutPage}" />
            <ShellContent
                Title="Calendar"
                Route="CalendarPage"
                ContentTemplate="{DataTemplate views:CalendarPage}" />
        </Tab>
        <Tab Title="Hero" Route="hero" Icon="tab_hero.png">
            <ShellContent
                Title="Hero"
                Route="CharacterPage"
                ContentTemplate="{DataTemplate views:CharacterPage}" />
            <ShellContent
                Title="Profile"
                Route="ProfilePage"
                ContentTemplate="{DataTemplate views:ProfilePage}" />
        </Tab>
        <Tab Title="Quests" Route="quests" Icon="tab_quests.png">
            <ShellContent
                Route="QuestPage"
                ContentTemplate="{DataTemplate views:QuestPage}" />
        </Tab>
        <Tab Title="Guild" Route="guild" Icon="tab_guild.png">
            <ShellContent
                Title="Duels"
                Route="ChallengePage"
                ContentTemplate="{DataTemplate views:ChallengePage}" />
            <ShellContent
                Title="Friends"
                Route="FriendsPage"
                ContentTemplate="{DataTemplate views:FriendsPage}" />
            <ShellContent
                Title="Ranks"
                Route="LeaderboardPage"
                ContentTemplate="{DataTemplate views:LeaderboardPage}" />
        </Tab>
    </TabBar>

</Shell>
